      "seed": 7146457,
      "version": 1,
      "versionNonce": 3751757,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Effect teardown: alive=false, matchMedia.revert(), disconnect both observers, cancel\nqueued RAF, detach pending handlers, clear image sources and Maps.\nReduced motion returns before loading / pin setup; the poster (or a previously painted\nstill) remains.\nNo canvas context also leaves the poster available.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Effect teardown: alive=false, matchMedia.revert(), disconnect both observers, cancel\nqueued RAF, detach pending handlers, clear image sources and Maps.\nReduced motion returns before loading / pin setup; the poster (or a previously painted\nstill) remains.\nNo canvas context also leaves the poster available.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 19
    },
