    },
    {
      "id": "cv-0181",
      "type": "text",
      "x": 4869,
      "y": 653.2,
      "width": 762,
      "height": 130.0,
      "angle": 0,
      "strokeColor": "#edf2ef",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "group-motionctx"
      ],
      "frameId": "cv-0026",
      "roundness": null,
      "seed": 3162613,
      "version": 1,
      "versionNonce": 1660313,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "The provider wraps the entire main element.\nuseReducedMotion() reads it in WorldAtlas, ModelStage, and ScrollSequence.\nThe preference hook uses useSyncExternalStore to subscribe to the device media\nquery.\nThis is the only custom shared context.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The provider wraps the entire main element.\nuseReducedMotion() reads it in WorldAtlas, ModelStage, and ScrollSequence.\nThe preference hook uses useSyncExternalStore to subscribe to the device media\nquery.\nThis is the only custom shared context.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
