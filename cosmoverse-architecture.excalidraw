      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "selectedWorld = 0 → selected planet index\nmotionOff = false → manual motion toggle\nmenuOpen / filmOpen = false → modal visibility\n\nRefs: root, menu, film, progress.\nDerived: reduced = motionOff || systemReduced.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "selectedWorld = 0 → selected planet index\nmotionOff = false → manual motion toggle\nmenuOpen / filmOpen = false → modal visibility\n\nRefs: root, menu, film, progress.\nDerived: reduced = motionOff || systemReduced.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
