      "type": "text",
      "x": 2049,
      "y": 1538.2,
      "width": 762,
      "height": 104.0,
      "angle": 0,
      "strokeColor": "#edf2ef",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
