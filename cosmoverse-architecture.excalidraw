    {
      "id": "cv-0405",
      "type": "text",
      "x": 4869,
      "y": 4198.2,
      "width": 762,
      "height": 148.20000000000002,
      "angle": 0,
      "strokeColor": "#edf2ef",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
