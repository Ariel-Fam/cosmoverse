      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "GSAP target state.frame: 0→N−1.\nScrollTrigger: top top, pin=true, scrub=.45,\nanticipatePin=1.\nDesktop ≥800 px: 1.6 × vh.\nMobile ≤799 px: 1.1 × vh.\ncompact=true: 0.9 × vh on either.\nRound + clamp to valid index.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GSAP target state.frame: 0→N−1.\nScrollTrigger: top top, pin=true, scrub=.45,\nanticipatePin=1.\nDesktop ≥800 px: 1.6 × vh.\nMobile ≤799 px: 1.1 × vh.\ncompact=true: 0.9 × vh on either.\nRound + clamp to valid index.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 19
    },
