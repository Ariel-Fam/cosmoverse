      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Universe → onFilm() → filmOpen → video dialog.\nAtlas → journalOpen → current planet’s journal dialog.\nHeader menu → menuOpen → chapter directory.\nThese flows do not replace the route or add a data-fetching layer.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Universe → onFilm() → filmOpen → video dialog.\nAtlas → journalOpen → current planet’s journal dialog.\nHeader menu → menuOpen → chapter directory.\nThese flows do not replace the route or add a data-fetching layer.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
