      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Folder→slug pairs live in the preparation script. Importing the generated JSON keeps\nframe counts aligned with actual outputs.\nThe script writes derivatives but does not purge stale files from an older run.\nSharp is currently supplied through the installed dependency tree rather than declared as\na direct project dependency.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Folder→slug pairs live in the preparation script. Importing the generated JSON keeps\nframe counts aligned with actual outputs.\nThe script writes derivatives but does not purge stale files from an older run.\nSharp is currently supplied through the installed dependency tree rather than declared as\na direct project dependency.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 19
    },
