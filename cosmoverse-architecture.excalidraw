      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "flyby: 151 source → 76 WebP frames.\ndisassembly: 121 → 61.\ndiscovery: 121 → 61.\ncockpit: 120 → 61.\nEach record provides count, sourceCount, and path.\nThe four engines share code, not one global cache or one shared concurrency budget.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "flyby: 151 source → 76 WebP frames.\ndisassembly: 121 → 61.\ndiscovery: 121 → 61.\ncockpit: 120 → 61.\nEach record provides count, sourceCount, and path.\nThe four engines share code, not one global cache or one shared concurrency budget.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 19
    },
