      "seed": 7076565,
      "version": 1,
      "versionNonce": 3715065,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "ResizeObserver measures the pinned section.\nBuffer width/height = CSS dimensions × min(devicePixelRatio, 1.5).\n2D context uses alpha:false.\ncoverScale = max(bufferWidth / imageWidth, bufferHeight / imageHeight).\nImage is centered; excess edges are cropped.\nCanvas resize queues a repaint; labels and track scale update via DOM refs.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ResizeObserver measures the pinned section.\nBuffer width/height = CSS dimensions × min(devicePixelRatio, 1.5).\n2D context uses alpha:false.\ncoverScale = max(bufferWidth / imageWidth, bufferHeight / imageHeight).\nImage is centered; excess edges are cropped.\nCanvas resize queues a repaint; labels and track scale update via DOM refs.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 19
    },
