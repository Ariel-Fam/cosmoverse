      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "cache: Map<index, HTMLImageElement>.\npending: Map<index, HTMLImageElement>.\nfailed: Set<index>; failed indices are not retried during this effect’s lifetime.\nEvict cached entries farther than ±14 from current frame; at most 29 index positions fit\nthat window. Desired prefetch spans at most 21.\nOff-margin cache.clear(); existing requests can finish but their images are discarded if still\noutside.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "cache: Map<index, HTMLImageElement>.\npending: Map<index, HTMLImageElement>.\nfailed: Set<index>; failed indices are not retried during this effect’s lifetime.\nEvict cached entries farther than ±14 from current frame; at most 29 index positions fit\nthat window. Desired prefetch spans at most 21.\nOff-margin cache.clear(); existing requests can finish but their images are discarded if still\noutside.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 19
    },
