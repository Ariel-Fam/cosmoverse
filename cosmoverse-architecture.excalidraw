      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "SceneBoundary catches rendering / model-load errors. Unsupported Canvas fallback\ninvokes onError. webglcontextlost also invokes onError.\nfailed=true removes ModelViewer, retains the illustration, and changes the status\nlabel.\nNo automatic retry resets failed inside the current mounted stage.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SceneBoundary catches rendering / model-load errors. Unsupported Canvas fallback\ninvokes onError. webglcontextlost also invokes onError.\nfailed=true removes ModelViewer, retains the illustration, and changes the status\nlabel.\nNo automatic retry resets failed inside the current mounted stage.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
