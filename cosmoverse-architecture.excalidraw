      "seed": 8020107,
      "version": 1,
      "versionNonce": 4210407,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Desktop hero layers headline, character, copy, and planet rail. Atlas uses a wide scene\nwith side content.\n≤700 px: selector becomes 4×2; atlas content stacks; bottom facts flow vertically; model\ncopy stacks above canvas.\n≤1000 px hides the model detail / step-control column. Sequence logic separately\nswitches at 800 px.\nsvh, min-heights, and shallow-screen rules stabilize scenes.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Desktop hero layers headline, character, copy, and planet rail. Atlas uses a wide scene\nwith side content.\n≤700 px: selector becomes 4×2; atlas content stacks; bottom facts flow vertically; model\ncopy stacks above canvas.\n≤1000 px hides the model detail / step-control column. Sequence logic separately\nswitches at 800 px.\nsvh, min-heights, and shallow-screen rules stabilize scenes.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 19
    },
