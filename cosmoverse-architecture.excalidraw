      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "RootLayout exports title, description, Open Graph, X metadata, and themeColor.\nmetadataBase is http://localhost:3000.\nPreview image: /webDesignTemplates/CosmoVerse.png, 1672×941.\nPlanet selection is client state, so it does not produce a per-world URL or per-world\nmetadata record.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RootLayout exports title, description, Open Graph, X metadata, and themeColor.\nmetadataBase is http://localhost:3000.\nPreview image: /webDesignTemplates/CosmoVerse.png, 1672×941.\nPlanet selection is client state, so it does not produce a per-world URL or per-world\nmetadata record.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
