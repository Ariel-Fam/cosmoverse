      "link": null,
      "locked": false,
      "text": "Open original field journal → journalOpen=true.\nEffect calls dialog.showModal(). Only then is the original PNG mounted via Next\nImage.\nClose button, backdrop click, or native close / Escape synchronizes state back to\nfalse.\nA separate link opens the full-resolution PNG in a new tab.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Open original field journal → journalOpen=true.\nEffect calls dialog.showModal(). Only then is the original PNG mounted via Next\nImage.\nClose button, backdrop click, or native close / Escape synchronizes state back to\nfalse.\nA separate link opens the full-resolution PNG in a new tab.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
