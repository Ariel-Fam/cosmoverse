      "opacity": 100,
      "groupIds": [
        "group-worldevents"
      ],
      "frameId": "cv-0026",
      "roundness": null,
      "seed": 3267451,
      "version": 1,
      "versionNonce": 1715351,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Universe onSelect = chooseWorld(index).\nHero mini-system also calls chooseWorld(index).\nHome sends WorldAtlas selected={selectedWorld}.\nWorldAtlas onSelect = setSelectedWorld.\n\nAtlas-local state: tab, journalOpen. Parent selections and atlas selections share the\nsame index.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Universe onSelect = chooseWorld(index).\nHero mini-system also calls chooseWorld(index).\nHome sends WorldAtlas selected={selectedWorld}.\nWorldAtlas onSelect = setSelectedWorld.\n\nAtlas-local state: tab, journalOpen. Parent selections and atlas selections share the\nsame index.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
