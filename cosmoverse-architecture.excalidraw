    },
    {
      "id": "cv-0273",
      "type": "text",
      "x": 2949,
      "y": 3068.2,
      "width": 762,
      "height": 130.0,
      "angle": 0,
      "strokeColor": "#edf2ef",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "group-cleanup-motion"
      ],
      "frameId": "cv-0034",
      "roundness": null,
      "seed": 4770129,
      "version": 1,
      "versionNonce": 2504229,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "The model and sequence effects return before creating pins when reduced is true.\nAtlas skips its transition effect.\nRoot cleanup cancels the queued frame and reverts its GSAP context.\nCSS also disables smooth scrolling and shortens animations / transitions for the\nsystem preference.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The model and sequence effects return before creating pins when reduced is true.\nAtlas skips its transition effect.\nRoot cleanup cancels the queued frame and reverts its GSAP context.\nCSS also disables smooth scrolling and shortens animations / transitions for the\nsystem preference.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
