      ],
      "frameId": "cv-0042",
      "roundness": null,
      "seed": 5958293,
      "version": 1,
      "versionNonce": 3127993,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Observer exit sets near=false and ready=false. The conditional viewer unmounts.\nRe-entering mounts it again unless failed.\nStage cleanup disconnects its observer and reverts its GSAP context. Model cleanup\nunregisters invalidate().\nUnmounting the viewer is not explicit eviction of useGLTF’s cached assets.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Observer exit sets near=false and ready=false. The conditional viewer unmounts.\nRe-entering mounts it again unless failed.\nStage cleanup disconnects its observer and reverts its GSAP context. Model cleanup\nunregisters invalidate().\nUnmounting the viewer is not explicit eviction of useGLTF’s cached assets.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
