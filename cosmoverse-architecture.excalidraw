      "version": 1,
      "versionNonce": 4549808,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "3D: extend ModelKind + paths in model-viewer.tsx, add the ModelStage content record,\nsupply a GLB and poster.\nSequence: add folder→slug in prepare-assets.mjs, regenerate manifest + WebPs, and\nmount ScrollSequence.\nThen update Home’s chapter order, ids, next/nextLabel links, directory, and relevant\nCSS.\nStatic imports / content tables are the current extension points.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3D: extend ModelKind + paths in model-viewer.tsx, add the ModelStage content record,\nsupply a GLB and poster.\nSequence: add folder→slug in prepare-assets.mjs, regenerate manifest + WebPs, and\nmount ScrollSequence.\nThen update Home’s chapter order, ids, next/nextLabel links, directory, and relevant\nCSS.\nStatic imports / content tables are the current extension points.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 19
    },
