    {
      "id": "cv-0191",
      "type": "text",
      "x": 4869,
      "y": 1068.2,
      "width": 762,
      "height": 156.0,
      "angle": 0,
      "strokeColor": "#edf2ef",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "group-exhibitevents"
      ],
      "frameId": "cv-0026",
      "roundness": null,
      "seed": 3337343,
      "version": 1,
      "versionNonce": 1752043,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "React state: near, ready, failed, step.\nMutable refs: root, progress, invalidate.\nViewer callbacks: onReady, onError, registerInvalidate.\n\nGSAP stores numeric progress outside React. Only the three-state copy index calls\nsetStep; unchanged values can bail out in React.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "React state: near, ready, failed, step.\nMutable refs: root, progress, invalidate.\nViewer callbacks: onReady, onError, registerInvalidate.\n\nGSAP stores numeric progress outside React. Only the three-state copy index calls\nsetStep; unchanged values can bail out in React.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
