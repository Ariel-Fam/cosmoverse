      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Next Image: hero, backdrops, journal PNGs, posters.\nwindow.Image: explicit sequence frame URLs.\nuseGLTF: original model GLBs near exhibits.\nHTML video: /cosmaeFlyby.mp4 only mounted while the film dialog is open.\nThe video uses controls, playsInline, autoPlay, and preload=\"metadata\".",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Next Image: hero, backdrops, journal PNGs, posters.\nwindow.Image: explicit sequence frame URLs.\nuseGLTF: original model GLBs near exhibits.\nHTML video: /cosmaeFlyby.mp4 only mounted while the film dialog is open.\nThe video uses controls, playsInline, autoPlay, and preload=\"metadata\".",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 19
    },
