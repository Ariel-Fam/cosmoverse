      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Skip link, named navigation, labeled buttons, focus-visible outlines, aria-pressed\nselectors, and tablist keyboard behavior.\nNative showModal dialogs supply browser focus containment; close events synchronize\nReact state.\nModel-step prose uses aria-live=\"polite\". Canvas sequences are decorative and have\ntextual descriptions.\nDevice reduced-motion preference is respected throughout.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Skip link, named navigation, labeled buttons, focus-visible outlines, aria-pressed\nselectors, and tablist keyboard behavior.\nNative showModal dialogs supply browser focus containment; close events synchronize\nReact state.\nModel-step prose uses aria-live=\"polite\". Canvas sequences are decorative and have\ntextual descriptions.\nDevice reduced-motion preference is respected throughout.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 19
    },
