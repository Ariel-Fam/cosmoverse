    {
      "id": "cv-0269",
      "type": "text",
      "x": 2049,
      "y": 3068.2,
      "width": 762,
      "height": 130.0,
      "angle": 0,
      "strokeColor": "#edf2ef",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "group-refresh"
      ],
      "frameId": "cv-0034",
      "roundness": null,
      "seed": 4700237,
      "version": 1,
      "versionNonce": 2467537,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Children set up their pins. Home schedules a requestAnimationFrame to sort and\nrefresh ScrollTriggers in document order.\ndocument.fonts.ready requests another refresh while the effect is alive.\nPinned sections use function-based lengths and invalidateOnRefresh for viewport\nchanges.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Children set up their pins. Home schedules a requestAnimationFrame to sort and\nrefresh ScrollTriggers in document order.\ndocument.fonts.ready requests another refresh while the effect is alive.\nPinned sections use function-based lengths and invalidateOnRefresh for viewport\nchanges.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
