      "baseline": 24
    },
    {
      "id": "cv-0368",
      "type": "text",
      "x": 2049,
      "y": 4203.2,
      "width": 762,
      "height": 208.0,
      "angle": 0,
      "strokeColor": "#edf2ef",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "group-transforms"
      ],
      "frameId": "cv-0046",
      "roundness": null,
      "seed": 6430064,
      "version": 1,
      "versionNonce": 3375664,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Y rotation = base + p × π × 1.6.\nbase is −0.6 for Ark; −0.25 otherwise.\nX rotation: Ark = 0.25 + sin(pπ) × 0.2;\ncrystal = sin(pπ) × 0.3; AstroMech = 0.\nY position = sin(pπ) × 0.1.\n\nThis is a whole-model orbit / tilt animation. Ark’s exploded anatomy is an image\nsequence, not mesh-by-mesh 3D disassembly.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Y rotation = base + p × π × 1.6.\nbase is −0.6 for Ark; −0.25 otherwise.\nX rotation: Ark = 0.25 + sin(pπ) × 0.2;\ncrystal = sin(pπ) × 0.3; AstroMech = 0.\nY position = sin(pπ) × 0.1.\n\nThis is a whole-model orbit / tilt animation. Ark’s exploded anatomy is an image\nsequence, not mesh-by-mesh 3D disassembly.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
