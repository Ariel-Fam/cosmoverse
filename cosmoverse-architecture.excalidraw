      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Canvas → Suspense → Model.\nModel returns Group → primitive(normalized clone).\nGroup ref receives transforms.\nThe GLB’s materials and geometry are reused;\ncloning the Object3D tree is not deep-copying every\ntexture.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Canvas → Suspense → Model.\nModel returns Group → primitive(normalized clone).\nGroup ref receives transforms.\nThe GLB’s materials and geometry are reused;\ncloning the Object3D tree is not deep-copying every\ntexture.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 19
    },
