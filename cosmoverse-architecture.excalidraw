      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "public/optimized/ → hero, world backdrops, sequence frames, and fallback posters.\npublic/models/ → the three GLB models.\npublic/narrative/ → original journal PNGs.\npublic/cosmaeFlyby.mp4 → optional film dialog.\nBundled font files arrive with the app assets.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public/optimized/ → hero, world backdrops, sequence frames, and fallback posters.\npublic/models/ → the three GLB models.\npublic/narrative/ → original journal PNGs.\npublic/cosmaeFlyby.mp4 → optional film dialog.\nBundled font files arrive with the app assets.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
