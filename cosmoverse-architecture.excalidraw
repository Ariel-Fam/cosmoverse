      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "WorldAtlas: background + text transition per selected planet.\nModelStage: progress 0→1; pin length 1.4 × viewport height; scrub 0.7.\nScrollSequence: frame 0→N−1; scrub 0.45; desktop / mobile lengths in frame 09.\nEach owner registers and reverts its own context or matchMedia.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WorldAtlas: background + text transition per selected planet.\nModelStage: progress 0→1; pin length 1.4 × viewport height; scrub 0.7.\nScrollSequence: frame 0→N−1; scrub 0.45; desktop / mobile lengths in frame 09.\nEach owner registers and reverts its own context or matchMedia.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
