      "link": null,
      "locked": false,
      "text": "Deep space #031014, off-white #e8e9df, teal #29c5bc, red #eb492e, gold #e5b04c,\nand translucent instrument borders.\nAnton: display headings. Barlow Condensed: body / labels. IBM Plex Mono: telemetry\n/ microcopy.\nFonts come from local @fontsource packages. Tailwind 4 is imported; the experience\nis primarily custom semantic CSS.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deep space #031014, off-white #e8e9df, teal #29c5bc, red #eb492e, gold #e5b04c,\nand translucent instrument borders.\nAnton: display headings. Barlow Condensed: body / labels. IBM Plex Mono: telemetry\n/ microcopy.\nFonts come from local @fontsource packages. Tailwind 4 is imported; the experience\nis primarily custom semantic CSS.",
      "autoResize": false,
      "lineHeight": 1.3,
