      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Filter filenames by /^\\d+\\.png$/; numeric ascending sort.\nKeep each even source-array index plus the last source frame.\nResize to at most 1280 px without enlargement; WebP quality 78.\nWrite sequential {0..N−1}.webp files.\nFinally write count, sourceCount, and URL prefix to lib/sequences.json.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Filter filenames by /^\\d+\\.png$/; numeric ascending sort.\nKeep each even source-array index plus the last source frame.\nResize to at most 1280 px without enlargement; WebP quality 78.\nWrite sequential {0..N−1}.webp files.\nFinally write count, sourceCount, and URL prefix to lib/sequences.json.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
