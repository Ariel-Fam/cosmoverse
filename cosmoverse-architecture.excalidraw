      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "0 Overview: inhabitants, culture, quote + attribution.\n1 Planet data: eight facts + terrain composition.\n2 Landmarks: ordered names + descriptions.\n\nThree role=\"tab\" buttons use aria-selected and roving tabIndex. Left / Right wrap;\nHome / End jump. Each tab controls the same labeled panel.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "0 Overview: inhabitants, culture, quote + attribution.\n1 Planet data: eight facts + terrain composition.\n2 Landmarks: ordered names + descriptions.\n\nThree role=\"tab\" buttons use aria-selected and roving tabIndex. Left / Right wrap;\nHome / End jump. Each tab controls the same labeled panel.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
