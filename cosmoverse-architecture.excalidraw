      "locked": false,
      "text": "npm run lint → ESLint.\nnpm run build → production compilation / TypeScript\n/ prerender.\nValidate asset paths and frame continuity after\nmedia changes.\nBuild success alone does not verify visual\nchoreography or GPU behavior.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "npm run lint → ESLint.\nnpm run build → production compilation / TypeScript\n/ prerender.\nValidate asset paths and frame continuity after\nmedia changes.\nBuild success alone does not verify visual\nchoreography or GPU behavior.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 19
    },
