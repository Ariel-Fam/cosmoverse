      "version": 1,
      "versionNonce": 2357461,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Always: header becomes scrolled after 80 px; page progress scales with ScrollTrigger\nprogress.\nMotion enabled: hero entrance, portrait + background parallax, one-time .reveal\nentrances, 45 s SVG orbit rotation, and pulsing Cosmae star.\nMotion disabled: skip those animation registrations. Semantic content remains\nrendered.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Always: header becomes scrolled after 80 px; page progress scales with ScrollTrigger\nprogress.\nMotion enabled: hero entrance, portrait + background parallax, one-time .reveal\nentrances, 45 s SVG orbit rotation, and pulsing Cosmae star.\nMotion disabled: skip those animation registrations. Semantic content remains\nrendered.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
