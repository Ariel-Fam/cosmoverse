    {
      "id": "cv-0108",
      "type": "text",
      "x": 1029,
      "y": 1468.2,
      "width": 762,
      "height": 130.0,
      "angle": 0,
      "strokeColor": "#edf2ef",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "group-boundary"
      ],
      "frameId": "cv-0018",
      "roundness": null,
      "seed": 1887084,
      "version": 1,
      "versionNonce": 990684,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "The current implementation has one product route and no custom API routes,\ndatabase, authentication, CMS fetches, or persistent user store.\nWorlds and sequence manifests are module imports. Interaction state lives in the\nbrowser for this page session.\nNext’s server still serves the app; “static content” does not mean no local server.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The current implementation has one product route and no custom API routes,\ndatabase, authentication, CMS fetches, or persistent user store.\nWorlds and sequence manifests are module imports. Interaction state lives in the\nbrowser for this page session.\nNext’s server still serves the app; “static content” does not mean no local server.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
    {
      "id": "cv-0109",
      "type": "text",
      "x": 105,
      "y": 1740,
      "width": 1710,
      "height": 23.400000000000002,
      "angle": 0,
      "strokeColor": "#a8bbc6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "cv-0018",
      "roundness": null,
      "seed": 1904557,
      "version": 1,
      "versionNonce": 999857,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Library roles: GSAP 3.15 = timelines / ScrollTrigger; R3F 9.7 = React scene renderer; Drei 10.7 = helpers; Three 0.186 = geometry / WebGL. Versions shown are declared dependencies.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Library roles: GSAP 3.15 = timelines / ScrollTrigger; R3F 9.7 = React scene renderer; Drei 10.7 = helpers; Three 0.186 = geometry / WebGL. Versions shown are declared dependencies.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 18
    },
