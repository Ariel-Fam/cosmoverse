      "boundElements": [],
      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "Header + directory use anchor hrefs. Scene skip links lead to the next model /\nchapter. Footer links return to #worlds or #top.\nchooseWorld(index) additionally sets selectedWorld and scrolls #worlds into view.\nScene numbers follow the story, not separate pages.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Header + directory use anchor hrefs. Scene skip links lead to the next model /\nchapter. Footer links return to #worlds or #top.\nchooseWorld(index) additionally sets selectedWorld and scrolls #worlds into view.\nScene numbers follow the story, not separate pages.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
