    {
      "id": "cv-0187",
      "type": "text",
      "x": 3969,
      "y": 1068.2,
      "width": 762,
      "height": 182.0,
      "angle": 0,
      "strokeColor": "#edf2ef",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
