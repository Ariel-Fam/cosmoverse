    {
      "id": "cv-0341",
      "type": "text",
      "x": 129,
      "y": 4668.2,
      "width": 762,
      "height": 130.0,
      "angle": 0,
      "strokeColor": "#edf2ef",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
