      "updated": 1789421174667,
      "created": 1789421174667,
      "link": null,
      "locked": false,
      "text": "There is no Redux, Zustand, browser-storage preference, or URL-synchronized world\nstate. Reload returns to initial state.\nAnchor links identify chapters; the chosen planet and active atlas tab are not encoded\nin the URL.\nLocal dialog state is synchronized with native dialog open / close events.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There is no Redux, Zustand, browser-storage preference, or URL-synchronized world\nstate. Reload returns to initial state.\nAnchor links identify chapters; the chosen planet and active atlas tab are not encoded\nin the URL.\nLocal dialog state is synchronized with native dialog open / close events.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
