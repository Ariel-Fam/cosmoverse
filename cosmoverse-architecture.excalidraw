      "link": null,
      "locked": false,
      "text": "Loop over backgrounds and isolatedAstroMech PNGs.\nResize width to at most 1672 px; withoutEnlargement=true.\nEncode WebP quality 88.\nPreserve the original basename and folder category.\n\nConsumers use Next Image with responsive sizes; hero imagery has priority. The\nsocial-preview metadata uses the supplied design-template PNG.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Loop over backgrounds and isolatedAstroMech PNGs.\nResize width to at most 1672 px; withoutEnlargement=true.\nEncode WebP quality 88.\nPreserve the original basename and folder category.\n\nConsumers use Next Image with responsive sizes; hero imagery has priority. The\nsocial-preview metadata uses the supplied design-template PNG.",
      "autoResize": false,
      "lineHeight": 1.3,
      "baseline": 20
    },
